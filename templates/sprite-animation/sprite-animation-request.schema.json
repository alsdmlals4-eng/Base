{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alsdmlals4-eng.github.io/Base/schemas/sprite-animation-request.schema.json",
  "title": "Sprite Animation Studio Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "asset_id", "asset_kind", "anchor", "action"],
  "allOf": [
    {
      "if": {"properties": {"mode": {"enum": ["expression_variation", "pose_sequence"]}}, "required": ["mode"]},
      "then": {"properties": {"asset_kind": {"const": "character"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "effect_stages"}}, "required": ["mode"]},
      "then": {"properties": {"asset_kind": {"const": "effect"}}}
    }
  ],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "asset_kind": {"enum": ["character", "effect"]},
    "mode": {"enum": ["expression_variation", "pose_sequence", "effect_stages", "sprite_action"], "default": "sprite_action"},
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "figma_node_url", "approval_status"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "figma_node_url": {"type": "string", "format": "uri"},
        "approval_status": {"const": "approved"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "frame_count", "fps", "loop_mode", "prompt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "direction": {"enum": ["left", "right", "up", "down", "none"]},
        "frame_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "fps": {"type": "integer", "minimum": 1, "maximum": 60},
        "loop_mode": {"enum": ["none", "linear", "pingpong"]},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
