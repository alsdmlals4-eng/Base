{
  "$id": "loop-immutable-run-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_role": {"const": "LOOP_IMMUTABLE_RUN"},
    "design_drift_status": {"enum": ["NOT_CHECKED", "NO_DRIFT", "MINOR_TECHNICAL_DRIFT", "PLANNING_CONFLICT", "VISUAL_CONFLICT"]},
    "evidence": {"items": {"type": "object"}, "type": "array"},
    "findings": {"items": {"type": "object"}, "type": "array"},
    "package_id": {"pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$", "type": "string"},
    "project_id": {"pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$", "type": "string"},
    "receipt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "run_id": {"pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$", "type": "string"},
    "schema_version": {"const": 1},
    "source_main_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "state": {"enum": ["CREATED", "SHADOW_COMPLETE", "WAITING_INTEGRATION", "CLOSED", "DEFERRED", "STOPPED", "QUARANTINED"]}
  },
  "required": ["schema_version", "contract_role", "run_id", "project_id", "source_main_sha", "package_id", "state", "evidence", "findings", "design_drift_status", "receipt_sha256"],
  "type": "object"
}
