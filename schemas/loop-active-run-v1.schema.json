{
  "$id": "loop-active-run-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_run": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$",
          "type": "string"
        }
      ]
    },
    "contract_role": {
      "const": "LOOP_ACTIVE_RUN_POINTER"
    },
    "project_id": {
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_main_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_role",
    "project_id",
    "source_main_sha",
    "active_run"
  ],
  "type": "object"
}
