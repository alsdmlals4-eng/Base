{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alsdmlals4-eng/Base/schemas/base-v9-3-release-evidence-v1.schema.json",
  "title": "Base v9.3 Release Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_role", "release_line", "evidence_status", "repository", "candidate_issue", "candidate_pull_request", "release_payload_commit", "candidate_registry", "validation", "product_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_role": {"const": "BASE_V9_3_RELEASE_EVIDENCE"},
    "release_line": {"const": "v9.3.0"},
    "evidence_status": {"const": "RECORDED_ON_TRUSTED_MAIN_BEFORE_PIN_FINALIZATION"},
    "repository": {"const": "alsdmlals4-eng/Base"},
    "candidate_issue": {"const": 107},
    "candidate_pull_request": {"type": "integer", "minimum": 1},
    "release_payload_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "hash_definition"],
      "properties": {
        "path": {"const": "skills/SKILL_REGISTRY.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_definition": {"const": "RAW_FILE_BYTES_SHA256"}
      }
    },
    "validation": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "product_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["godot_runtime", "device", "accessibility", "human_validation"],
      "properties": {
        "godot_runtime": {"const": "NOT_RUN"},
        "device": {"const": "NOT_RUN"},
        "accessibility": {"const": "NOT_RUN"},
        "human_validation": {"const": "NOT_RUN"}
      }
    }
  }
}
