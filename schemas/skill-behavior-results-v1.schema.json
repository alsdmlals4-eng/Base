{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alsdmlals4-eng/Base/schemas/skill-behavior-results-v1.schema.json",
  "title": "Base Skill Behavior Evaluation Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "run_status",
    "repository",
    "commit_sha",
    "generated_at",
    "model",
    "source_identity",
    "review",
    "results"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_role": {"const": "BASE_SKILL_BEHAVIOR_RESULTS"},
    "run_status": {"enum": ["NOT_RUN", "COMPLETED"]},
    "repository": {"const": "alsdmlals4-eng/Base"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1}
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_path",
        "registry_sha256",
        "evaluation_paths",
        "evaluation_sha256"
      ],
      "properties": {
        "registry_path": {"const": "skills/SKILL_REGISTRY.json"},
        "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluation_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "skills/SKILL_BEHAVIOR_EVALS.json",
              "skills/SKILL_BEHAVIOR_COVERAGE_EVALS.json"
            ]
          },
          "contains": {"const": "skills/SKILL_BEHAVIOR_EVALS.json"}
        },
        "evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_context_id",
        "reviewer_context_id",
        "independent",
        "author_summary_visible"
      ],
      "properties": {
        "author_context_id": {"type": "string", "minLength": 1},
        "reviewer_context_id": {"type": "string", "minLength": 1},
        "independent": {"type": "boolean"},
        "author_summary_visible": {"type": "boolean"}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "work_mode",
          "primary_skill",
          "supporting_skills",
          "skill_modes",
          "evidence",
          "user_decision_state"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^SBE-[0-9]{3}$"},
          "work_mode": {"enum": ["PLAN", "BUILD", "REVIEW"]},
          "primary_skill": {"type": "string", "minLength": 1},
          "supporting_skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "skill_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "user_decision_state": {"enum": ["NOT_REQUIRED", "REQUIRED", "DEFERRED"]},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"run_status": {"const": "NOT_RUN"}}},
      "then": {
        "properties": {
          "results": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"run_status": {"const": "COMPLETED"}}},
      "then": {
        "properties": {
          "review": {
            "properties": {
              "independent": {"const": true}
            }
          },
          "results": {"minItems": 1}
        }
      }
    }
  ]
}
