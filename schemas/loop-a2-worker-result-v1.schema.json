{
  "$id": "loop-a2-worker-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_paths": {
      "items": {
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "contract_role": {
      "const": "LOOP_A2_WORKER_RESULT"
    },
    "errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expected_main_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "package_id": {
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$",
      "type": "string"
    },
    "role": {
      "const": "BUILDER"
    },
    "run_id": {
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "BLOCKED"
      ]
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "usage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "turns": {
          "maximum": 50,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "turns"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "contract_role",
    "project_id",
    "run_id",
    "package_id",
    "expected_main_sha",
    "role",
    "status",
    "changed_paths",
    "summary",
    "usage",
    "errors"
  ],
  "type": "object"
}
