{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alsdmlals4-eng/Base/schemas/archive-retention-adapter-v1.schema.json",
  "title": "Archive Retention Adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_role", "base", "project", "paths", "policies", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter_role": {"const": "legacy-retention-archive-project-adapter"},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "skill_id", "skill_path", "route_registry"],
      "properties": {
        "repository": {"const": "alsdmlals4-eng/Base"},
        "commit": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"const": "PIN_ON_PROJECT_ADOPTION"}
          ]
        },
        "skill_id": {"const": "governing-legacy-retention-and-archives"},
        "skill_path": {"const": "skills/governing-legacy-retention-and-archives/SKILL.md"},
        "route_registry": {"const": "skills/BASE_SHARED_SKILL_ROUTES.json"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "layout_policy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "layout_policy": {"const": "preserve-existing-canonical-paths"}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_agents",
        "documentation_map",
        "active_context",
        "skill_registry",
        "canonical_sources",
        "archive_root",
        "archive_readme",
        "archive_manifest",
        "protected_paths",
        "legacy_search_roots",
        "generated_derivative_roots",
        "protected_evidence_roots"
      ],
      "properties": {
        "project_agents": {"$ref": "#/$defs/path"},
        "documentation_map": {"$ref": "#/$defs/path"},
        "active_context": {"$ref": "#/$defs/path"},
        "skill_registry": {"$ref": "#/$defs/path"},
        "canonical_sources": {"$ref": "#/$defs/path_list"},
        "archive_root": {"$ref": "#/$defs/path"},
        "archive_readme": {"$ref": "#/$defs/path"},
        "archive_manifest": {"$ref": "#/$defs/path"},
        "protected_paths": {"$ref": "#/$defs/path_list"},
        "legacy_search_roots": {"$ref": "#/$defs/path_list"},
        "generated_derivative_roots": {"$ref": "#/$defs/path_list"},
        "protected_evidence_roots": {"$ref": "#/$defs/path_list"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_original_content",
        "blank_placeholders_allowed",
        "secrets_may_be_archived",
        "default_active_authority",
        "default_implementation_authority",
        "branch_retention"
      ],
      "properties": {
        "preserve_original_content": {"const": true},
        "blank_placeholders_allowed": {"const": false},
        "secrets_may_be_archived": {"const": false},
        "default_active_authority": {"const": false},
        "default_implementation_authority": {"const": "NONE"},
        "branch_retention": {
          "enum": ["AUDIT_TAG_THEN_DELETE", "CLOSED_PR_AND_TAG_UNTIL_DELETE_AVAILABLE"]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "manual_checks", "status_vocabulary"],
      "properties": {
        "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "manual_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status_vocabulary": {"const": ["PASS", "PARTIAL", "FAIL", "NOT_RUN"]}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
    "path_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
  }
}
