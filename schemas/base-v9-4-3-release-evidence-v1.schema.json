{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alsdmlals4-eng/Base/schemas/base-v9-4-3-release-evidence-v1.schema.json",
  "title": "Base v9.4.3 Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "release_line",
    "evidence_status",
    "repository",
    "release_issue",
    "source_pr",
    "payload_commit",
    "registry_sha256",
    "verification",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_role": {"const": "BASE_V9_4_3_RELEASE_EVIDENCE"},
    "release_line": {"const": "v9.4.3"},
    "evidence_status": {"const": "CANDIDATE_VALIDATED_BEFORE_TRUSTED_EVIDENCE_PIN"},
    "repository": {"const": "alsdmlals4-eng/Base"},
    "release_issue": {"const": 148},
    "source_pr": {"const": 143},
    "payload_commit": {"pattern": "^[0-9a-f]{40}$"},
    "registry_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_exact_head",
        "source_merge_commit",
        "required_workflows",
        "unresolved_review_threads"
      ],
      "properties": {
        "source_exact_head": {"pattern": "^[0-9a-f]{40}$"},
        "source_merge_commit": {"pattern": "^[0-9a-f]{40}$"},
        "required_workflows": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unresolved_review_threads": {"const": 0}
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_model_behavior",
        "prompt_rework_reduction",
        "human_comprehension",
        "real_project_adapter_execution",
        "runtime_device_accessibility"
      ],
      "properties": {
        "cross_model_behavior": {"const": "NOT_RUN"},
        "prompt_rework_reduction": {"const": "NOT_RUN"},
        "human_comprehension": {"const": "NOT_RUN"},
        "real_project_adapter_execution": {"const": "NOT_RUN"},
        "runtime_device_accessibility": {"const": "NOT_APPLICABLE"}
      }
    }
  }
}
