{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_role", "scope", "claims", "acceptance", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_role": {"const": "REVIEW_EVIDENCE_RECORD"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_changed_paths", "protected_paths"],
      "properties": {
        "allowed_changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pattern"}},
        "protected_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pattern"}}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_type", "claim_text", "acceptance_ids", "check_ids"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/id"},
          "claim_type": {"enum": ["IMPLEMENTATION", "VERIFICATION"]},
          "claim_text": {"type": "string", "minLength": 1},
          "acceptance_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "check_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent_id", "approved_intent", "implementation_paths", "required_level"],
        "properties": {
          "intent_id": {"$ref": "#/$defs/id"},
          "approved_intent": {"type": "string", "minLength": 1},
          "implementation_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
          "required_level": {"$ref": "#/$defs/level"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "argv", "working_directory", "timeout_seconds", "declared_level", "acceptance_ids", "markers"],
        "properties": {
          "check_id": {"$ref": "#/$defs/id"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "working_directory": {"oneOf": [{"const": "."}, {"$ref": "#/$defs/path"}]},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
          "declared_level": {"enum": ["STATIC", "TEST", "RUNTIME", "RENDER"]},
          "acceptance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "markers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$", "not": {"const": "."}},
    "pattern": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "level": {"enum": ["STATIC", "TEST", "RUNTIME", "RENDER", "HUMAN"]}
  }
}
