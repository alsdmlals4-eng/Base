; Isolated Editor transaction Pilot for the Base Godot live-editor v2 contract.
config_version=5

[application]

config/name="Base Godot Editor Transaction Pilot"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/base_live_editor_adapter_pilot/plugin.cfg")
